{
  "format": "clashfork-routing",
  "version": 1,
  "type": "ruleset",
  "name": "Mainland China · Proxy selected services",
  "rules": [
    {
      "name": "Google and YouTube",
      "conditions": [
        {
          "kind": "domain_suffix",
          "value": "google.com"
        },
        {
          "kind": "domain_suffix",
          "value": "googleapis.com"
        },
        {
          "kind": "domain_suffix",
          "value": "gstatic.com"
        },
        {
          "kind": "domain_suffix",
          "value": "googleusercontent.com"
        },
        {
          "kind": "domain_suffix",
          "value": "youtube.com"
        },
        {
          "kind": "domain_suffix",
          "value": "youtube-nocookie.com"
        },
        {
          "kind": "domain_suffix",
          "value": "youtu.be"
        },
        {
          "kind": "domain_suffix",
          "value": "ytimg.com"
        },
        {
          "kind": "domain_suffix",
          "value": "googlevideo.com"
        }
      ],
      "destination": {
        "kind": "proxy",
        "proxyRef": "proxy-main",
        "label": "Proxy node"
      }
    },
    {
      "name": "OpenAI, ChatGPT, and Codex",
      "conditions": [
        {
          "kind": "domain_suffix",
          "value": "openai.com"
        },
        {
          "kind": "domain_suffix",
          "value": "chatgpt.com"
        },
        {
          "kind": "domain_suffix",
          "value": "oaiusercontent.com"
        },
        {
          "kind": "domain_suffix",
          "value": "oaistatic.com"
        },
        {
          "kind": "domain_suffix",
          "value": "oaistatsig.com"
        },
        {
          "kind": "domain_suffix",
          "value": "openaimerge.com"
        },
        {
          "kind": "domain",
          "value": "challenges.cloudflare.com"
        },
        {
          "kind": "domain",
          "value": "setup.workos.com"
        },
        {
          "kind": "domain",
          "value": "forwarder.workos.com"
        },
        {
          "kind": "domain",
          "value": "frontend-apps-multi-region.workos.com"
        },
        {
          "kind": "domain",
          "value": "cdn.workos.com"
        },
        {
          "kind": "domain",
          "value": "images.workoscdn.com"
        },
        {
          "kind": "domain",
