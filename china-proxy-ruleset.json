        }
      ],
      "destination": {
        "kind": "proxy",
        "proxyRef": "proxy-main",
        "label": "Proxy node"
      }
    },
    {
      "name": "GitHub",
      "conditions": [
        {
          "kind": "domain_suffix",
          "value": "github.com"
        },
        {
          "kind": "domain_suffix",
          "value": "githubusercontent.com"
        },
        {
          "kind": "domain_suffix",
          "value": "githubassets.com"
        },
        {
          "kind": "domain_suffix",
          "value": "githubcopilot.com"
        }
      ],
      "destination": {
        "kind": "proxy",
        "proxyRef": "proxy-main",
        "label": "Proxy node"
      }
    },
    {
      "name": "OpenCode",
      "conditions": [
        {
          "kind": "domain_suffix",
          "value": "opencode.ai"
        },
        {
          "kind": "domain_suffix",
          "value": "models.dev"
