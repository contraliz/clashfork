        },
        {
          "kind": "domain_suffix",
          "value": "discord.gg"
        },
        {
          "kind": "domain_suffix",
          "value": "discordapp.com"
        },
        {
          "kind": "domain_suffix",
          "value": "discordapp.net"
        }
      ],
      "destination": {
        "kind": "proxy",
        "proxyRef": "proxy-main",
        "label": "Proxy node"
