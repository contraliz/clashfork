{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clashfork",
  "version": "1.0.12",
  "identifier": "io.clashfork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clashfork",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Clashfork",
    "copyright": "Clashfork contributors. GPL-3.0-only; based on Clash Verge Rev.",
    "shortDescription": "Clashfork TUN desktop client",
    "longDescription": "TUN desktop client for stock Mihomo with local routing, subscriptions, history and diagnostics.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["resources"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
